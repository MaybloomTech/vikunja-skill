#!/usr/bin/env python3
"""vk: a small Vikunja client for coding agents. Prints one line per task.

Config (first found wins):
  VIKUNJA_TOKEN / ~/.config/vikunja/token   API token (Settings -> API Tokens)
  VIKUNJA_URL   / ~/.config/vikunja/url     the instance, e.g. https://tasks.example.org

Only the Python standard library; Vikunja API v2 (2.4+).
"""
import argparse
import datetime as dt
import html
import http.client
import json
import os
import re
import sys
import urllib.parse

CFG = os.path.expanduser("~/.config/vikunja")
NULL_DATE = "0001-01-01T00:00:00Z"
PRIO = {0: "", 1: "P1", 2: "P2", 3: "P3", 4: "P4", 5: "P5"}


def cfg(name, default=None):
    try:
        with open(os.path.join(CFG, name)) as f:
            return f.read().strip()
    except FileNotFoundError:
        return default


URL = (os.environ.get("VIKUNJA_URL") or cfg("url") or "").rstrip("/")
TOKEN = os.environ.get("VIKUNJA_TOKEN") or cfg("token")
DEFAULT_BUCKETS = ["Backlog", "Next", "Doing", "Waiting", "Done"]  # first = default, last = done
STAMP = "last-recent"  # ~/.config/vikunja/last-recent: when `vk recent` last ran on this machine
CLIP = 240  # chars of a comment `vk recent` shows before pointing at `vk show`


class ApiError(Exception):
    def __init__(self, code, text):
        super().__init__(f"HTTP {code}: {text}")
        self.code = code


_conn = None


def call(method, path, body=None, params=None, ctype="application/json"):
    """One HTTPS connection per run (keep-alive): one name lookup and one TLS
    handshake for the whole command, not one per request."""
    global _conn
    if not URL:
        sys.exit("no instance URL: run `vk init <token> --url https://...` or set VIKUNJA_URL")
    if not TOKEN:
        sys.exit("no token: run `vk init <token>` or set VIKUNJA_TOKEN")
    u = urllib.parse.urlsplit(URL)
    target = u.path.rstrip("/") + "/api/v2" + path
    if params:
        target += "?" + urllib.parse.urlencode(params, doseq=True)
    data = json.dumps(body).encode() if body is not None else None
    headers = {"Authorization": "Bearer " + TOKEN, "Content-Type": ctype, "Accept": "application/json"}
    for attempt in (1, 2):
        if _conn is None:
            cls = http.client.HTTPSConnection if u.scheme == "https" else http.client.HTTPConnection
            _conn = cls(u.hostname, u.port, timeout=30)
        try:
            _conn.request(method, target, body=data, headers=headers)
            r = _conn.getresponse()
            raw = r.read()
            break
        except (http.client.HTTPException, OSError):
            _conn.close()  # the server dropped the idle connection: reconnect once
            _conn = None
            if attempt == 2:
                raise
    if r.status == 304:  # Not Modified: the value was already what we asked for
        return None
    if r.status >= 400:
        raise ApiError(r.status, raw.decode(errors="replace")[:400].strip())
    return json.loads(raw) if raw else None


def items(path, params=None):
    """Collect every page of a v2 paginated envelope."""
    out, page = [], 1
    while True:
        r = call("GET", path, params={**(params or {}), "page": page, "per_page": 50})
        if isinstance(r, list):
            return r
        out += r.get("items") or []
        if page >= (r.get("total_pages") or 1):
            return out
        page += 1


# ---------- formatting ----------

def to_html(text):
    """Vikunja stores descriptions/comments as HTML. Plain text goes in as
    paragraphs; `# ` headings, `- ` / `1. ` lists and `code` spans keep their
    shape, so to_text() gives the same text back."""
    if not text or text.lstrip().startswith("<"):
        return text or ""

    def inline(s):
        return re.sub(r"`([^`]+)`", r"<code>\1</code>", html.escape(s))

    out = []
    for block in re.split(r"\n\s*\n", text.strip()):
        lines = block.strip().split("\n")
        head = re.match(r"(#{1,6}) (.*)", block) if len(lines) == 1 else None
        if head:
            n = len(head.group(1))
            out.append(f"<h{n}>{inline(head.group(2))}</h{n}>")
        elif all(l.startswith("- ") for l in lines):
            out.append("<ul>" + "".join(f"<li>{inline(l[2:])}</li>" for l in lines) + "</ul>")
        elif all(re.match(r"\d+\. ", l) for l in lines):
            out.append("<ol>" + "".join(f"<li>{inline(l.split('. ', 1)[1])}</li>" for l in lines) + "</ol>")
        else:
            out.append("<p>" + "<br>".join(inline(l) for l in lines) + "</p>")
    return "".join(out)


def to_text(h):
    if not h:
        return ""
    h = re.sub(r"<li[^>]*>\s*<p[^>]*>(.*?)</p>\s*</li>", r"<li>\1</li>", h, flags=re.S)  # editor wraps items in <p>
    h = re.sub(r"<h(\d)[^>]*>", lambda m: "#" * int(m.group(1)) + " ", h)
    h = re.sub(r"</h\d>", "\n\n", h)

    def ol(m):
        items = re.findall(r"<li[^>]*>(.*?)</li>", m.group(1), flags=re.S)
        return "".join(f"{i}. {t}\n" for i, t in enumerate(items, 1)) + "\n"
    h = re.sub(r"<ol[^>]*>(.*?)</ol>", ol, h, flags=re.S)
    h = re.sub(r"<li[^>]*>", "- ", h)
    h = re.sub(r"</li>", "\n", h)
    h = re.sub(r"</(ul|p|div|pre)>", "\n\n", h)
    h = re.sub(r"<br\s*/?>", "\n", h)
    h = re.sub(r"</?code[^>]*>", "`", h)
    h = re.sub(r"<[^>]+>", "", h)
    h = re.sub(r"[ \t]+\n", "\n", html.unescape(h))
    return re.sub(r"\n{3,}", "\n\n", h).strip()


def date(s):
    if not s or s.startswith("0001-"):
        return ""
    return s[:10]


def when(s):
    """An API timestamp as an aware datetime (offsets differ between records,
    so string comparison is wrong)."""
    return dt.datetime.fromisoformat(s.replace("Z", "+00:00"))


def clip(text, full=False):
    """The first two lines of a comment, at most CLIP chars, unless full."""
    if full:
        return text
    lines = [l for l in text.split("\n") if l.strip()]
    out = "\n".join(lines[:2])
    cut = len(lines) > 2 or len(out) > CLIP
    return (out[:CLIP].rstrip() + " ...") if cut else out


def ref(t):
    """The id the web UI shows: LAB-3 when the project has an identifier,
    otherwise the global #id (the UI's bare #3 is per project, so ambiguous)."""
    ident = t.get("identifier") or ""
    return ident if ident and not ident.startswith("#") else f"#{t['id']}"


def task_id(s):
    """argparse type: 29, #29 (global id) or LAB-3 (project identifier + index)."""
    m = re.fullmatch(r"#?(\d+)", s)
    if m:
        return int(m.group(1))
    m = re.fullmatch(r"([A-Za-z][A-Za-z0-9]*)-(\d+)", s)
    if not m:
        raise argparse.ArgumentTypeError(f"not a task id: {s} (29 or LAB-3)")
    pid = next((p["id"] for p in load_projects().values() if p["identifier"].upper() == m.group(1).upper()), None)
    if pid is None:
        raise argparse.ArgumentTypeError(f"no project with identifier {m.group(1).upper()}")
    found = items("/tasks", {"filter": f"project = {pid} && index = {m.group(2)}"})
    if not found:
        raise argparse.ArgumentTypeError(f"no task {s.upper()}")
    return found[0]["id"]


def fmt_task(t, projects=None):
    proj = ""
    if projects:
        p = projects.get(t.get("project_id"))
        proj = p["path"].split("/")[-1] if p else str(t.get("project_id"))
    who = ",".join("@" + a["username"] for a in t.get("assignees") or [])
    labels = ",".join(l["title"] for l in t.get("labels") or [])
    due = date(t.get("due_date"))
    cols = [ref(t), PRIO.get(t.get("priority", 0), ""), proj, who,
            f"[{labels}]" if labels else "", f"due {due}" if due else "",
            "DONE" if t.get("done") else "", t["title"]]
    return "  ".join(c for c in cols if c)


# ---------- lookups ----------

_projects = None


def load_projects(fresh=False):
    """id -> {id, title, parent, path}. path is Parent/Child. Cached per run."""
    global _projects
    if _projects is not None and not fresh:
        return _projects
    ps = {p["id"]: p for p in items("/projects", {"is_archived": "false"})}

    def path(p):
        par = p.get("parent_project_id")
        return (path(ps[par]) + "/" if par and par in ps else "") + p["title"]
    _projects = {i: {"id": i, "title": p["title"], "parent": p.get("parent_project_id"), "path": path(p),
                     "identifier": p.get("identifier") or "",
                     "description": to_text(p.get("description"))}
                 for i, p in ps.items()}
    return _projects


def me():
    """The account behind the token."""
    return call("GET", "/user") or {}


def find_project(name, projects=None):
    projects = projects or load_projects()
    if name.isdigit() and int(name) in projects:
        return projects[int(name)]
    n = name.lower()
    full = [p for p in projects.values() if p["path"].lower() == n]
    if len(full) == 1:
        return full[0]
    last = [p for p in projects.values() if p["title"].lower() == n]
    if len(last) == 1:
        return last[0]
    if len(last) > 1:
        sys.exit(f"ambiguous project {name!r}: " + ", ".join(p["path"] for p in last))
    sys.exit(f"no project {name!r}; try `vk projects`")


def find_user(project_id, name):
    for u in items(f"/projects/{project_id}/users/search", {"q": name}):
        if u.get("username", "").lower() == name.lower():
            return u
    sys.exit(f"no user {name!r} with access to project {project_id}")


def find_label(title, create=False):
    for l in items("/labels"):
        if l["title"].lower() == title.lower():
            return l
    if create:
        return call("POST", "/labels", {"title": title})
    sys.exit(f"no label {title!r}; try `vk labels`")


def kanban(project_id):
    """(view, buckets) of the project's kanban view."""
    views = [v for v in items(f"/projects/{project_id}/views") if v.get("view_kind") == "kanban"]
    if not views:
        sys.exit(f"project {project_id} has no kanban view")
    v = views[0]
    return v, items(f"/projects/{project_id}/views/{v['id']}/buckets")


def find_bucket(project_id, name):
    v, buckets = kanban(project_id)
    for b in buckets:
        if b["title"].lower() == name.lower():
            return v, b
    sys.exit(f"no bucket {name!r}; have: " + ", ".join(b["title"] for b in buckets))


def get_task(tid):
    r = call("GET", f"/tasks/{tid}")
    return r.get("task", r) if isinstance(r, dict) and "task" in r else r


def update(path, changes, get):
    """JSON Patch, with a GET+PUT fallback if the server declines it."""
    ops = [{"op": "replace", "path": "/" + k, "value": v} for k, v in changes.items()]
    try:
        return call("PATCH", path, ops, ctype="application/json-patch+json") or get()
    except ApiError as e:
        if e.code not in (400, 405, 415, 422):
            raise
    t = get()
    t.update(changes)
    return call("PUT", path, t)


def update_task(tid, changes):
    return update(f"/tasks/{tid}", changes, lambda: get_task(tid))


# ---------- commands ----------

def cmd_init(a):
    os.makedirs(CFG, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(CFG, "token"), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as f:
        f.write(a.token.strip() + "\n")
    global TOKEN, URL, _conn
    TOKEN = a.token.strip()
    _conn = None
    if a.url:
        URL = a.url.strip().rstrip("/")
        with open(os.path.join(CFG, "url"), "w") as f:
            f.write(URL + "\n")
    ps = load_projects()
    print(f"ok: {len(ps)} projects visible at {URL}")


def cmd_projects(a):
    for p in sorted(load_projects().values(), key=lambda p: p["path"].lower()):
        print(f"{p['id']:>4}  {p['path']}" + (f"  [{p['identifier']}]" if p["identifier"] else ""))
        if a.verbose and p["description"]:
            print("      " + p["description"].replace("\n", "\n      "))


def cmd_project(a):
    """One project: what goes in it (its description) and its buckets."""
    p = find_project(a.project)
    if a.desc is not None:
        text = sys.stdin.read() if a.desc == "-" else a.desc
        update(f"/projects/{p['id']}", {"description": to_html(text)}, lambda: call("GET", f"/projects/{p['id']}"))
        p = find_project(str(p["id"]), load_projects(fresh=True))
    if a.identifier is not None:
        update(f"/projects/{p['id']}", {"identifier": a.identifier.upper()}, lambda: call("GET", f"/projects/{p['id']}"))
        p = find_project(str(p["id"]), load_projects(fresh=True))
    print(f"{p['id']:>4}  {p['path']}" + (f"  [{p['identifier']}]" if p["identifier"] else ""))
    if p["description"]:
        print("      " + p["description"].replace("\n", "\n      "))
    v, buckets = kanban(p["id"])
    names = [b["title"] + (" (done)" if b["id"] == v.get("done_bucket_id") else "")
             for b in sorted(buckets, key=lambda b: b.get("position", 0))]
    print("      buckets: " + ", ".join(names))


def cmd_ls(a):
    projects = load_projects()
    parts = []
    if not a.all:
        parts.append("done = false")
    if a.project:
        p = find_project(a.project, projects)
        ids = [p["id"]] + [c["id"] for c in projects.values() if c["parent"] == p["id"]]
        parts.append("project in " + ", ".join(map(str, ids)))
    if a.assignee:
        parts.append(f"assignees in '{a.assignee}'")
    if a.label:
        parts.append(f"labels in {find_label(a.label)['id']}")
    params = {"sort_by": ["priority", "id"], "order_by": ["desc", "asc"]}
    if parts:
        params["filter"] = " && ".join(parts)
    tasks = items("/tasks", params)
    if a.json:
        print(json.dumps(tasks, indent=1))
        return
    for t in tasks:
        print(fmt_task(t, projects))
    if not tasks:
        print("(no tasks)")


def cmd_show(a):
    projects = load_projects()
    for tid in a.id:
        t = get_task(tid)
        if a.json:
            print(json.dumps(t, indent=1))
            continue
        print(fmt_task(t, projects))
        p = projects.get(t.get("project_id"))
        meta = [f"project {p['path']}" if p else "", f"created {date(t.get('created'))}",
                f"updated {date(t.get('updated'))}", f"done {date(t.get('done_at'))}" if t.get("done") else ""]
        print("  " + " | ".join(m for m in meta if m))
        if t.get("description"):
            print("  " + to_text(t["description"]).replace("\n", "\n  "))
        for c in items(f"/tasks/{tid}/comments", {"order_by": "asc"}):
            who = (c.get("author") or {}).get("username", "?")
            print(f"  > {date(c.get('created'))} {who}: " + to_text(c.get("comment")).replace("\n", "\n    "))
        print()


def apply_extras(t, a, projects):
    """Assignees, labels, bucket after create/edit."""
    pid = t["project_id"]
    for name in (a.assignee or []):
        u = find_user(pid, name)
        try:
            call("POST", f"/tasks/{t['id']}/assignees", {"user_id": u["id"]})
        except ApiError as e:
            if e.code != 400:
                raise  # 400 = already assigned
    for name in (a.label or []):
        l = find_label(name, create=True)
        try:
            call("POST", f"/tasks/{t['id']}/labels", {"label_id": l["id"]})
        except ApiError as e:
            if e.code != 400:
                raise
    if a.bucket:
        v, b = find_bucket(pid, a.bucket)
        call("PUT", f"/projects/{pid}/views/{v['id']}/buckets/{b['id']}/tasks", {"task_id": t["id"]})


def cmd_add(a):
    projects = load_projects()
    p = find_project(a.project, projects)
    body = {"title": a.title}
    if a.desc:
        body["description"] = to_html(a.desc)
    if a.priority is not None:
        body["priority"] = a.priority
    if a.due:
        body["due_date"] = a.due + "T12:00:00Z" if len(a.due) == 10 else a.due
    t = call("POST", f"/projects/{p['id']}/tasks", body)
    apply_extras(t, a, projects)
    print(fmt_task(get_task(t["id"]), projects))


def cmd_edit(a):
    projects = load_projects()
    changes = {}
    if a.title:
        changes["title"] = a.title
    if a.desc is not None:
        changes["description"] = to_html(a.desc)
    if a.priority is not None:
        changes["priority"] = a.priority
    if a.due is not None:
        changes["due_date"] = NULL_DATE if a.due in ("", "none") else (
            a.due + "T12:00:00Z" if len(a.due) == 10 else a.due)
    if a.project:
        changes["project_id"] = find_project(a.project, projects)["id"]
    for tid in a.id:
        t = update_task(tid, changes) if changes else get_task(tid)
        apply_extras(t, a, projects)
        for name in (a.unassign or []):
            u = find_user(t["project_id"], name)
            call("DELETE", f"/tasks/{tid}/assignees/{u['id']}")
        for name in (a.unlabel or []):
            call("DELETE", f"/tasks/{tid}/labels/{find_label(name)['id']}")
        print(fmt_task(get_task(tid), projects))


def cmd_done(a):
    projects = load_projects()
    for tid in a.id:
        if a.comment:
            call("POST", f"/tasks/{tid}/comments", {"comment": to_html(a.comment)})
        print(fmt_task(update_task(tid, {"done": not a.undo}), projects))


def cmd_comment(a):
    call("POST", f"/tasks/{a.id}/comments", {"comment": to_html(a.text)})
    print(f"{ref(get_task(a.id))} commented")


def cmd_mv(a):
    projects = load_projects()
    t = get_task(a.id)
    v, b = find_bucket(t["project_id"], a.bucket)
    call("PUT", f"/projects/{t['project_id']}/views/{v['id']}/buckets/{b['id']}/tasks", {"task_id": t["id"]})
    print(f"{ref(t)} -> {b['title']}")


def cmd_recent(a):
    """What changed since the last run on this machine (or -d DAYS), with the
    comments others wrote in that window. Own comments are noise to the
    account that wrote them, so they are hidden unless --mine."""
    projects = load_projects()
    now = dt.datetime.now(dt.timezone.utc).replace(microsecond=0)
    if a.days is not None:
        since, label = now - dt.timedelta(days=a.days), f"last {a.days} days"
    elif cfg(STAMP):
        since, label = when(cfg(STAMP)), "since the last `vk recent` on this machine"
    else:
        since, label = now - dt.timedelta(days=7), "last 7 days (first run here)"
    params = {"filter": f"updated >= '{since.strftime('%Y-%m-%dT%H:%M:%SZ')}'", "expand": "comment_count",
              "sort_by": ["updated"], "order_by": ["desc"]}
    if a.project:
        p = find_project(a.project, projects)
        ids = [p["id"]] + [c["id"] for c in projects.values() if c["parent"] == p["id"]]
        params["filter"] += " && project in " + ", ".join(map(str, ids))
    hide = None if a.mine else me().get("username")
    tasks = items("/tasks", params)
    print(f"# {label}: {since.astimezone().strftime('%Y-%m-%d %H:%M')} .. now, {len(tasks)} tasks"
          + ("" if a.mine else "; my own comments hidden (--mine shows them)") + ("" if a.full else "; comments clipped (--full)"))
    for t in tasks:
        comments = []
        if t.get("comment_count"):
            comments = [c for c in items(f"/tasks/{t['id']}/comments", {"order_by": "asc"})
                        if when(c.get("created")) >= since and (c.get("author") or {}).get("username") != hide]
        print(fmt_task(t, projects) + f"  (upd {date(t.get('updated'))})")
        for c in comments:
            who = (c.get("author") or {}).get("username", "?")
            print(f"  > {date(c.get('created'))} {who}: " + clip(to_text(c.get("comment")), a.full).replace("\n", "\n    "))
    if not a.project:  # a filtered run has not shown everything, so it does not advance the stamp
        os.makedirs(CFG, mode=0o700, exist_ok=True)
        with open(os.path.join(CFG, STAMP), "w") as f:
            f.write(now.isoformat() + "\n")


def unread():
    """Unread notifications of this account, oldest first, keyed by task id.
    Vikunja keeps the read state per notification on the server: it never
    contains my own actions, and every machine sees the same state."""
    by_task = {}
    for n in sorted(items("/notifications"), key=lambda n: n.get("created") or ""):
        task = (n.get("notification") or {}).get("task")
        if task and (n.get("read_at") or NULL_DATE) == NULL_DATE:
            by_task.setdefault(task["id"], []).append(n)
    return by_task


def cmd_inbox(a):
    """Unread notifications by task. Comments are clipped like in recent: a
    pasted log in one closing comment would otherwise land in every
    session's context on every machine until the card is acked."""
    projects = load_projects()
    by_task = unread()
    if not by_task:
        print("(inbox empty)")
    for tid, ns in by_task.items():
        try:
            print(fmt_task(get_task(tid), projects))
        except ApiError:
            print(f"#{tid}  (deleted)")
        for n in ns:
            d = n["notification"]
            who = (d.get("doer") or d.get("assignee") or {}).get("username", "?")
            c = d.get("comment")
            what = clip(to_text(c.get("comment")), a.full).replace("\n", "\n    ") if c else n.get("name", "?")
            print(f"  > {date(n.get('created'))} {who}: {what}")


def cmd_start(a):
    """The session routine in one call: projects with their conventions, the
    inbox, what changed, my open tasks (and a project's, with -p)."""
    projects = load_projects()
    who = me().get("username")
    print("== projects (a description is that project's conventions)")
    cmd_projects(argparse.Namespace(verbose=True))
    print("\n== inbox (act, then `vk ack ID`; comments clipped, `vk show ID` reads a card in full)")
    cmd_inbox(argparse.Namespace(full=False))
    print("\n== recent")
    cmd_recent(argparse.Namespace(days=a.days, project=None, mine=False, full=False))
    print(f"\n== open, assigned to @{who}")
    cmd_ls(argparse.Namespace(all=False, project=None, assignee=who, label=None, json=False))
    if a.project:
        print(f"\n== open in {find_project(a.project, projects)['path']}")
        cmd_ls(argparse.Namespace(all=False, project=a.project, assignee=None, label=None, json=False))


def cmd_ack(a):
    by_task = unread()
    for tid in a.id:
        for n in by_task.get(tid, []):
            call("PUT", f"/notifications/{n['id']}", {"read": True})
        print(f"{ref(get_task(tid))} acked {len(by_task.get(tid, []))}")


def cmd_labels(a):
    for l in items("/labels"):
        print(f"{l['id']:>4}  {l['title']}")


def cmd_buckets(a):
    p = find_project(a.project)
    v, buckets = kanban(p["id"])
    for b in sorted(buckets, key=lambda b: b.get("position", 0)):
        flag = "  (done bucket)" if b["id"] == v.get("done_bucket_id") else ""
        print(f"{b['id']:>4}  {b['title']}{flag}")


def ensure_buckets(pid, titles, done=None, default=None, order=False):
    """Create the buckets that are missing, then flag the done/default ones.
    order=True also puts them in the given order (before any others)."""
    v, buckets = kanban(pid)
    have = {b["title"].lower(): b for b in buckets}
    for title in titles:
        if title.lower() in have:
            print(f"bucket {title} exists")
            continue
        b = call("POST", f"/projects/{pid}/views/{v['id']}/buckets", {"title": title})
        have[title.lower()] = b
        print(f"{b['id']:>4}  {b['title']}")
    flags, said = {}, []
    for key, title in (("done_bucket_id", done), ("default_bucket_id", default)):
        if title and title.lower() in have:
            flags[key] = have[title.lower()]["id"]
            said.append(f"{key.split('_')[0]} bucket = {have[title.lower()]['title']}")
    if flags:
        v2 = {k: v[k] for k in v if k != "$schema"}
        v2.update(flags)
        call("PUT", f"/projects/{pid}/views/{v['id']}", v2)
        print(", ".join(said))
    if order:
        for i, title in enumerate(titles):
            b = have[title.lower()]
            call("PUT", f"/projects/{pid}/views/{v['id']}/buckets/{b['id']}", {**b, "position": (i + 1) * 1000})


def cmd_mkproject(a):
    projects = load_projects()
    body = {"title": a.title}
    if a.parent:
        body["parent_project_id"] = find_project(a.parent, projects)["id"]
    if a.desc:
        body["description"] = to_html(a.desc)
    p = call("POST", "/projects", body)
    print(f"{p['id']:>4}  {a.parent + '/' if a.parent else ''}{p['title']}")
    if not a.no_buckets:
        v, buckets = kanban(p["id"])  # Vikunja seeds To-Do/Doing/Done; To-Do becomes the first default
        stock = next((b for b in buckets if b["title"] == "To-Do"), None)
        if stock and not any(b["title"].lower() == DEFAULT_BUCKETS[0].lower() for b in buckets):
            call("PUT", f"/projects/{p['id']}/views/{v['id']}/buckets/{stock['id']}", {**stock, "title": DEFAULT_BUCKETS[0]})
        ensure_buckets(p["id"], DEFAULT_BUCKETS, done=DEFAULT_BUCKETS[-1], default=DEFAULT_BUCKETS[0], order=True)


def cmd_mkbucket(a):
    p = find_project(a.project)
    ensure_buckets(p["id"], a.title, done=a.done, default=a.default)


def main():
    ap = argparse.ArgumentParser(prog="vk", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true", help="raw JSON where supported")
    sp = ap.add_subparsers(dest="cmd", required=True)

    s = sp.add_parser("init", help="store the API token (and optional URL), test it")
    s.add_argument("token"); s.add_argument("--url"); s.set_defaults(f=cmd_init)

    s = sp.add_parser("projects", help="list projects as Parent/Child with ids")
    s.add_argument("-v", "--verbose", action="store_true", help="with each project's description"); s.set_defaults(f=cmd_projects)
    s = sp.add_parser("project", help="one project: description (what goes in it) and buckets")
    s.add_argument("project"); s.add_argument("-d", "--desc", help="set the description (plain text, - for stdin)")
    s.add_argument("--identifier", help="short task prefix, e.g. LAB: tasks show as LAB-3 (max 10 chars)")
    s.set_defaults(f=cmd_project)

    s = sp.add_parser("ls", help="open tasks, priority first")
    s.add_argument("-p", "--project", help="name, Parent/Child, or id; includes children")
    s.add_argument("-a", "--assignee", help="username")
    s.add_argument("-l", "--label")
    s.add_argument("--all", action="store_true", help="include done tasks")
    s.set_defaults(f=cmd_ls)

    s = sp.add_parser("show", help="task with description and comments")
    s.add_argument("id", nargs="+", type=task_id); s.set_defaults(f=cmd_show)

    s = sp.add_parser("add", help="create a task")
    s.add_argument("-p", "--project", required=True); s.add_argument("title")
    s.add_argument("-d", "--desc", help="plain text; blank line = paragraph")
    s.add_argument("-a", "--assignee", action="append"); s.add_argument("-l", "--label", action="append")
    s.add_argument("-P", "--priority", type=int, choices=range(0, 6)); s.add_argument("--due", help="YYYY-MM-DD")
    s.add_argument("-b", "--bucket"); s.set_defaults(f=cmd_add)

    s = sp.add_parser("edit", help="change fields, assignees, labels, bucket, project")
    s.add_argument("id", nargs="+", type=task_id); s.add_argument("-t", "--title")
    s.add_argument("-d", "--desc"); s.add_argument("-a", "--assignee", action="append")
    s.add_argument("--unassign", action="append"); s.add_argument("-l", "--label", action="append")
    s.add_argument("--unlabel", action="append"); s.add_argument("-P", "--priority", type=int, choices=range(0, 6))
    s.add_argument("--due", help="YYYY-MM-DD or none"); s.add_argument("-b", "--bucket"); s.add_argument("-p", "--project")
    s.set_defaults(f=cmd_edit)

    s = sp.add_parser("done", help="mark done (optionally with a closing comment)")
    s.add_argument("id", nargs="+", type=task_id); s.add_argument("-c", "--comment")
    s.add_argument("--undo", action="store_true"); s.set_defaults(f=cmd_done)

    s = sp.add_parser("comment", help="add a comment"); s.add_argument("id", type=task_id); s.add_argument("text"); s.set_defaults(f=cmd_comment)
    s = sp.add_parser("mv", help="move to a kanban bucket"); s.add_argument("id", type=task_id); s.add_argument("bucket"); s.set_defaults(f=cmd_mv)

    s = sp.add_parser("recent", help="what changed since the last run here (or -d DAYS), with others' new comments")
    s.add_argument("-d", "--days", type=int, help="a fixed window instead of 'since the last run on this machine'")
    s.add_argument("-p", "--project"); s.add_argument("--mine", action="store_true", help="include my own comments")
    s.add_argument("--full", action="store_true", help="whole comments, not the first two lines"); s.set_defaults(f=cmd_recent)
    s = sp.add_parser("start", help="the session routine in one call: projects -v, inbox, recent, my open tasks")
    s.add_argument("-p", "--project", help="also list that project's open tasks")
    s.add_argument("-d", "--days", type=int, help="window for the recent section"); s.set_defaults(f=cmd_start)
    s = sp.add_parser("inbox", help="unread notifications (comments, assignments, mentions), by task; comments clipped")
    s.add_argument("--full", action="store_true", help="whole comments, not the first two lines"); s.set_defaults(f=cmd_inbox)
    s = sp.add_parser("ack", help="mark a task's notifications read, once handled")
    s.add_argument("id", nargs="+", type=task_id); s.set_defaults(f=cmd_ack)

    s = sp.add_parser("labels", help="list labels"); s.set_defaults(f=cmd_labels)
    s = sp.add_parser("buckets", help="kanban buckets of a project"); s.add_argument("project"); s.set_defaults(f=cmd_buckets)
    s = sp.add_parser("mkproject", help="create a project with the default buckets")
    s.add_argument("title"); s.add_argument("--parent"); s.add_argument("-d", "--desc", help="what goes in it")
    s.add_argument("--no-buckets", action="store_true", help="leave the buckets as Vikunja creates them"); s.set_defaults(f=cmd_mkproject)
    s = sp.add_parser("mkbucket", help="create kanban buckets"); s.add_argument("project"); s.add_argument("title", nargs="+")
    s.add_argument("--done", help="bucket title to flag as the done bucket")
    s.add_argument("--default", help="bucket title new tasks land in"); s.set_defaults(f=cmd_mkbucket)

    a = ap.parse_args()
    try:
        a.f(a)
    except ApiError as e:
        sys.exit(f"vk: {e}")
    except OSError as e:
        sys.exit(f"vk: cannot reach {URL}: {e}")


if __name__ == "__main__":
    main()
